
# Google Gemini Cloud API Credentials
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Generation Parameters
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT=60

# Qdrant Vector Store
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=knowledge_base
QDRANT_VECTOR_SIZE=384
RETRIEVAL_MIN_SCORE=0.15

# Embedding Model
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Context & Session Budgets
MAX_CONTEXT_CHARS=5000
SESSION_MAX_TOKENS=3000
SESSION_MAX_INPUT_TOKENS=2400
SESSION_MAX_OUTPUT_TOKENS=600
SESSION_SOFT_TURN_BUDGET=800
SESSION_LIFETIME_MAX_TOKENS=6000
SESSION_LIMIT_REACHED_MESSAGE="Query limit reached. Restart convo."
SESSION_ENFORCE_BY=tokens

# Retrieval
RETRIEVAL_LIMIT_DEFAULT=5
CHUNKS_FILE=output/chunks.jsonl

